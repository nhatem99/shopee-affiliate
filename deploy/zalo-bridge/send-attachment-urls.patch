+/**
+ * Download one image URL into a uniquely named file under os.tmpdir() and
+ * return its path. Throws DownloadError when the URL can't yield an image.
+ */
+async function downloadImageToTemp(url) {
+  const ac = new AbortController();
+  const timer = setTimeout(() => ac.abort(), URL_DOWNLOAD_TIMEOUT_MS);
+  const timeoutMsg = `timed out after ${URL_DOWNLOAD_TIMEOUT_MS / 1000}s`;
+  try {
+    let resp;
+    try {
+      resp = await fetch(url, {
+        signal: ac.signal,
+        redirect: "follow",
+        headers: {
+          // Ask for formats Zalo can show; some CDNs hand avif to a bare "*/*".
+          Accept: "image/jpeg,image/png,image/webp,image/gif;q=0.9,image/*;q=0.5",
+          "User-Agent": URL_DOWNLOAD_UA,
+        },
+      });
+    } catch (e) {
+      // undici's message is just "fetch failed"; the useful part (ENOTFOUND,
+      // ECONNREFUSED, cert errors…) lives on e.cause.
+      const cause = e && e.cause ? e.cause.code || e.cause.message : null;
+      const reason = cause || String(e && e.message ? e.message : e);
+      throw new DownloadError(ac.signal.aborted ? timeoutMsg : `fetch failed: ${reason}`);
+    }
+    if (!resp.ok) throw new DownloadError(`HTTP ${resp.status}`);
+    const type = (resp.headers.get("content-type") || "").split(";")[0].trim().toLowerCase();
+    if (!type.startsWith("image/")) {
+      throw new DownloadError(`not an image (content-type: ${type || "none"})`);
+    }
+    const declared = parseInt(resp.headers.get("content-length") || "", 10);
+    if (Number.isFinite(declared) && declared > URL_DOWNLOAD_MAX_BYTES) {
+      throw new DownloadError(`too large (${declared} bytes > ${URL_DOWNLOAD_MAX_BYTES})`);
+    }
+    if (!resp.body) throw new DownloadError("empty body");
+    // content-length may be missing or wrong: count the real bytes and stop
+    // reading as soon as the cap is passed instead of buffering it all.
+    const chunks = [];
+    let total = 0;
+    try {
+      for await (const chunk of resp.body) {
+        total += chunk.length;
+        if (total > URL_DOWNLOAD_MAX_BYTES) {
+          throw new DownloadError(`too large (> ${URL_DOWNLOAD_MAX_BYTES} bytes)`);
+        }
+        chunks.push(chunk);
+      }
+    } catch (e) {
+      if (e instanceof DownloadError) throw e;
+      throw new DownloadError(ac.signal.aborted ? timeoutMsg : `read failed: ${String(e && e.message ? e.message : e)}`);
+    }
+    if (!total) throw new DownloadError("empty body");
+    const file = path.join(os.tmpdir(), `zalo-bridge-${crypto.randomUUID()}.${IMAGE_EXT_BY_TYPE[type] || "jpg"}`);
+    try {
+      await fs.promises.writeFile(file, Buffer.concat(chunks));
+    } catch (e) {
+      // A half-written file is never returned, so the caller can't clean it up.
+      await fs.promises.rm(file, { force: true }).catch(() => {});
+      throw e;
+    }
+    return file;
+  } finally {
+    clearTimeout(timer);
+    // Releases the socket when we bailed out before draining the body.
+    ac.abort();
+  }
+}
