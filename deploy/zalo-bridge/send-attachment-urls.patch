+// bridge (it often runs on a phone under Termux).
+const URL_DOWNLOAD_TIMEOUT_MS = 20_000; // per file, headers + body
+const URL_DOWNLOAD_MAX_BYTES = 15 * 1024 * 1024;
+const URL_MAX_COUNT = 10;
+const URL_DOWNLOAD_UA =
+  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36";
+// zca-js routes attachments by file extension, and only jpg/jpeg/png/webp can
+// carry the caption in the same bubble. CDN links rarely end in ".jpg", so the
+// extension comes from the response content-type, never from the URL.
+// Unknown image/* falls back to jpg (still routed as a photo).
+const IMAGE_EXT_BY_TYPE = {
+  "image/jpeg": "jpg",
+  "image/jpg": "jpg",
+  "image/pjpeg": "jpg",
+  "image/png": "png",
+  "image/webp": "webp",
+  "image/gif": "gif",
+};
+
+/** The URL itself is the problem (timeout, non-2xx, not an image, too big) → 422, not 500. */
+class DownloadError extends Error {}
+
+/** Returns an error string for a bad `urls` value, or null if it's usable. */
+function validateImageUrls(urls) {
+  if (!Array.isArray(urls) || !urls.length) return "urls must be a non-empty array of strings";
+  if (urls.length > URL_MAX_COUNT) return `too many urls (${urls.length} > ${URL_MAX_COUNT})`;
+  for (let i = 0; i < urls.length; i++) {
+    const u = urls[i];
+    if (typeof u !== "string" || !u) return `urls[${i}] must be a non-empty string`;
+    let parsed;
+    try {
+      parsed = new URL(u);
+    } catch {
+      return `urls[${i}] is not a valid URL: ${u}`;
+    }
+    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+      return `urls[${i}] must be http(s): ${u}`;
+    }
+  }
+  return null;
+}
